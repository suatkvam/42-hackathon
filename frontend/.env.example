VITE_TUSKY_API_KEY=your_tusky_api_key_here
VITE_TUSKY_VAULT_ID=your_vault_id_here
VITE_TUSKY_API_URL=https://api.tusky.io

# Smart Contract Configuration
VITE_PACKAGE_ID=your_package_id_here
VITE_REGISTRY_ID=your_registry_id_here
VITE_MODULE_NAME=linktree

# Analytics (Supabase) - Optional
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Cloudinary Configuration
# Get your credentials from: https://console.cloudinary.com/
# 1. Sign up / Login to Cloudinary
# 2. Go to Dashboard -> Settings -> Upload
# 3. Create an unsigned upload preset (or use existing one)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here
